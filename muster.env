# Vereinsflieger API Credentials - Template
# Kopiere diese Datei zu .env und trage deine echten Zugangsdaten ein

VEREINSFLIEGER_APPKEY=your_appkey_from_vereinsflieger
VEREINSFLIEGER_USERNAME=your.email@example.com
VEREINSFLIEGER_PASSWORD=your_password

# Optional: Nur notwendig wenn User Zugang zu mehreren Vereinen hat
# VEREINSFLIEGER_VEREINS_ID=12345

# Test-Konfiguration
# Callsign eines Flugzeugs für Reservierungs-Tests (z.B. D-KXXX)
TEST_AIRCRAFT_CALLSIGN=D-KXXX
